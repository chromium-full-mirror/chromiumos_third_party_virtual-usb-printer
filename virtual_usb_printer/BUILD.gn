import("//common-mk/pkg_config.gni")

pkg_config("target_defaults") {
  pkg_deps = [
    "libbrillo",
    "libchrome",
    "libipp",
    "libjpeg",
    "libxml-2.0",
  ]
}

executable("virtual-usb-printer") {
  sources = [
    "../common/value_util.cc",
    "cups_constants.cc",
    "device_descriptors.cc",
    "escl_manager.cc",
    "ipp_manager.cc",
    "ipp_util.cc",
    "jpeg_util.cc",
    "load_config.cc",
    "op_commands.cc",
    "server.cc",
    "usb_printer.cc",
    "usbip.cc",
    "virtual_usb_printer.cc",
    "xml_util.cc",
  ]
  configs += [ ":target_defaults" ]
  deps = [
    "//virtual-usb-printer/common:http_util",
    "//virtual-usb-printer/common:smart_buffer",
    "//virtual-usb-printer/mock_printer:implementation",
    "//virtual-usb-printer/mock_printer:mocking_protos",
    "//virtual-usb-printer/mock_printer:parse_textproto",
  ]
  install_path = "/usr/local/bin"
}

if (use.test) {
  pkg_config("test_config") {
    pkg_deps = [ "libchrome-test" ]
  }

  executable("escl-manager-testrunner") {
    sources = [
      "escl_manager.cc",
      "escl_manager_test.cc",
      "ipp_util.cc",
      "jpeg_util.cc",
      "xml_util.cc",
    ]
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    deps = [
      "//common-mk/testrunner",
      "//virtual-usb-printer/common:smart_buffer",
    ]
    run_test = true
  }

  executable("ipp-manager-testrunner") {
    sources = [
      "ipp_manager.cc",
      "ipp_manager_test.cc",
      "ipp_util.cc",
    ]
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    deps = [
      "//common-mk/testrunner",
      "//virtual-usb-printer/common:smart_buffer",
    ]
    run_test = true
  }

  executable("ipp-util-testrunner") {
    sources = [
      "../common/value_util.cc",
      "cups_constants.cc",
      "ipp_util.cc",
      "ipp_util_test.cc",
    ]

    # TODO(oka); Remove //common-mk:test by making testrunner to public_config //common-mk:test
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    deps = [
      "//common-mk/testrunner",
      "//virtual-usb-printer/common:http_util",
      "//virtual-usb-printer/common:smart_buffer",
    ]
    run_test = true
  }

  executable("jpeg-util-testrunner") {
    sources = [
      "jpeg_util.cc",
      "jpeg_util_test.cc",
    ]
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    deps = [ "//common-mk/testrunner" ]
    run_test = true
  }

  executable("load-config-testrunner") {
    sources = [
      "../common/value_util.cc",
      "device_descriptors.cc",
      "load_config.cc",
      "load_config_test.cc",
    ]
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    deps = [ "//common-mk/testrunner" ]
    run_test = true
  }

  executable("usb-printer-testrunner") {
    sources = [
      "../common/value_util.cc",
      "escl_manager.cc",
      "ipp_manager.cc",
      "ipp_util.cc",
      "jpeg_util.cc",
      "load_config.cc",
      "op_commands.cc",
      "server.cc",
      "usb_printer.cc",
      "usb_printer_test.cc",
      "usbip.cc",
      "xml_util.cc",
    ]
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    deps = [
      "//common-mk/testrunner",
      "//virtual-usb-printer/common:http_util",
      "//virtual-usb-printer/common:smart_buffer",
      "//virtual-usb-printer/mock_printer:implementation",
      "//virtual-usb-printer/mock_printer:mocking_protos",
      "//virtual-usb-printer/mock_printer:parse_textproto",
    ]
    run_test = true
  }
}

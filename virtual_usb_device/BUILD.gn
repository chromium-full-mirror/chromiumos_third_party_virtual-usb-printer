import("//common-mk/pkg_config.gni")

pkg_config("target_defaults") {
  pkg_deps = [
    "libbrillo",
    "libchrome",
    "libipp",
    "libjpeg",
    "libxml-2.0",
  ]
}

executable("virtual-usbip-host") {
  sources = [
    "../common/value_util.cc",
    "../common/value_util.h",
    "connection/connection_factory.cc",
    "connection/connection_factory.h",
    "connection/socket_connection.cc",
    "connection/socket_connection.h",
    "device_descriptors.cc",
    "device_descriptors.h",
    "load_config.cc",
    "load_config.h",
    "op_commands.cc",
    "op_commands.h",
    "server.cc",
    "server.h",
    "usb_util.cc",
    "usb_util.h",
    "usbip.cc",
    "usbip.h",
    "usbip_host/device_proxy.cc",
    "usbip_host/device_proxy.h",
    "usbip_host/main.cc",
    "usbip_host/usbip_core.cc",
    "usbip_host/usbip_core.h",
    "usbip_host/usbip_manager.cc",
    "usbip_host/usbip_manager.h",
    "usbip_host/usbip_server.cc",
    "usbip_host/usbip_server.h",
  ]
  configs += [ ":target_defaults" ]
  deps = [
    "//virtual-usb-printer/common:http_util",
    "//virtual-usb-printer/common:smart_buffer",
  ]
  install_path = "/usr/local/bin"
}

executable("virtual-printer") {
  sources = [
    "../common/value_util.cc",
    "../common/value_util.h",
    "connection/connection_factory.cc",
    "connection/connection_factory.h",
    "connection/socket_connection.cc",
    "connection/socket_connection.h",
    "cups_constants.cc",
    "cups_constants.h",
    "device_descriptors.cc",
    "device_descriptors.h",
    "ipp_manager.cc",
    "ipp_manager.h",
    "ipp_util.cc",
    "ipp_util.h",
    "load_config.cc",
    "load_config.h",
    "op_commands.cc",
    "op_commands.h",
    "server.cc",
    "server.h",
    "usb_device/device_server.cc",
    "usb_device/device_server.h",
    "usb_device/printer/printer.cc",
    "usb_device/printer/printer.h",
    "usb_device/scanner/escl_manager.cc",
    "usb_device/scanner/escl_manager.h",
    "usb_device/scanner/scan_jpeg_util.cc",
    "usb_device/scanner/scan_jpeg_util.h",
    "usb_device/scanner/scan_xml_util.cc",
    "usb_device/scanner/scan_xml_util.h",
    "usb_device/scanner/scanner.cc",
    "usb_device/scanner/scanner.h",
    "usb_device/usb_device.cc",
    "usb_device/usb_device.h",
    "usb_util.cc",
    "usb_util.h",
    "usbip.cc",
    "usbip.h",
  ]
  configs += [ ":target_defaults" ]
  deps = [
    "//virtual-usb-printer/common:http_util",
    "//virtual-usb-printer/common:smart_buffer",
    "//virtual-usb-printer/mock_printer:implementation",
    "//virtual-usb-printer/mock_printer:mocking_protos",
    "//virtual-usb-printer/mock_printer:parse_textproto",
  ]
  install_path = "/usr/local/bin"
}

if (use.test) {
  pkg_config("test_config") {
    pkg_deps = [ "libchrome-test" ]
  }

  executable("virtual-usbip-host-test") {
    sources = [
      "connection/connection_factory.cc",
      "connection/connection_factory.h",
      "connection/socket_connection.cc",
      "connection/socket_connection.h",
      "device_descriptors.cc",
      "device_descriptors.h",
      "op_commands.cc",
      "op_commands.h",
      "server.cc",
      "server.h",
      "usbip_host/usbip_manager.cc",
      "usbip_host/usbip_manager.h",
      "usbip_host/usbip_manager_test.cc",
    ]
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    deps = [
      "//common-mk/testrunner",
      "//virtual-usb-printer//common:smart_buffer",
    ]
  }
}

import("//common-mk/pkg_config.gni")
import("//common-mk/proto_library.gni")

group("all") {
  deps = [ ":virtual-usb-printer" ]
  if (use.test) {
    deps += [
      ":escl-manager-testrunner",
      ":http-util-testrunner",
      ":ipp-manager-testrunner",
      ":ipp-matching-validation-testrunner",
      ":ipp-util-testrunner",
      ":jpeg-util-testrunner",
      ":load-config-testrunner",
      ":smart-buffer-testrunner",
    ]
  }
}

pkg_config("target_defaults") {
  pkg_deps = [
    "libbrillo",
    "libchrome",
    "libjpeg",
    "libxml-2.0",

    # We're not performance-sensitive enough
    # to want protobuf-lite at the moment.
    "protobuf",
  ]
}

proto_library("mocking_protos") {
  proto_in_dir = "./mock_printer/proto"
  proto_out_dir = "include/proto"
  sources = [
    "${proto_in_dir}/control_flow.proto",
    "${proto_in_dir}/ipp.proto",
  ]
}

source_set("mock_printer_test_support") {
  configs += [ ":target_defaults" ]
  public = [ "mock_printer/proto_test_utils.h" ]
  public_deps = [ ":mocking_protos" ]
  sources = [ "mock_printer/proto_test_utils.cc" ]
}

source_set("ipp_matching_validation") {
  configs += [ ":target_defaults" ]
  deps = [ ":mocking_protos" ]

  public = [ "mock_printer/ipp_matching_validation.h" ]
  sources = [ "mock_printer/ipp_matching_validation.cc" ]
}

source_set("mock_printer") {
  deps = [ ":ipp_matching_validation" ]
}

executable("virtual-usb-printer") {
  configs += [ ":target_defaults" ]
  deps = [ ":mock_printer" ]
  sources = [
    "cups_constants.cc",
    "device_descriptors.cc",
    "escl_manager.cc",
    "http_util.cc",
    "ipp_manager.cc",
    "ipp_util.cc",
    "jpeg_util.cc",
    "load_config.cc",
    "op_commands.cc",
    "server.cc",
    "smart_buffer.cc",
    "usb_printer.cc",
    "usbip.cc",
    "value_util.cc",
    "virtual_usb_printer.cc",
    "xml_util.cc",
  ]
}

if (use.test) {
  pkg_config("test_config") {
    pkg_deps = [ "libchrome-test" ]
  }

  executable("escl-manager-testrunner") {
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    sources = [
      "escl_manager.cc",
      "escl_manager_test.cc",
      "ipp_util.cc",
      "jpeg_util.cc",
      "smart_buffer.cc",
      "xml_util.cc",
    ]
    deps = [ "//common-mk/testrunner" ]
  }

  executable("http-util-testrunner") {
    # TODO(oka); Remove //common-mk:test by making testrunner to public_config //common-mk:test
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    sources = [
      "http_util.cc",
      "http_util_test.cc",
      "smart_buffer.cc",
      "value_util.cc",
    ]
    deps = [ "//common-mk/testrunner" ]
  }

  executable("ipp-manager-testrunner") {
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    sources = [
      "ipp_manager.cc",
      "ipp_manager_test.cc",
      "ipp_util.cc",
      "smart_buffer.cc",
    ]
    deps = [ "//common-mk/testrunner" ]
  }

  executable("ipp-matching-validation-testrunner") {
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    deps = [
      ":ipp_matching_validation",
      ":mock_printer_test_support",
      "//common-mk/testrunner",
    ]
    sources = [ "mock_printer/ipp_matching_validation_test.cc" ]
  }

  executable("ipp-util-testrunner") {
    # TODO(oka); Remove //common-mk:test by making testrunner to public_config //common-mk:test
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    sources = [
      "cups_constants.cc",
      "http_util.cc",
      "ipp_util.cc",
      "ipp_util_test.cc",
      "smart_buffer.cc",
      "value_util.cc",
    ]
    deps = [ "//common-mk/testrunner" ]
  }

  executable("jpeg-util-testrunner") {
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    sources = [
      "jpeg_util.cc",
      "jpeg_util_test.cc",
    ]
    deps = [ "//common-mk/testrunner" ]
  }

  executable("smart-buffer-testrunner") {
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    sources = [
      "smart_buffer.cc",
      "smart_buffer_test.cc",
      "value_util.cc",
    ]
    deps = [ "//common-mk/testrunner" ]
  }

  executable("load-config-testrunner") {
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    sources = [
      "device_descriptors.cc",
      "load_config.cc",
      "load_config_test.cc",
      "value_util.cc",
    ]
    deps = [ "//common-mk/testrunner" ]
  }
}

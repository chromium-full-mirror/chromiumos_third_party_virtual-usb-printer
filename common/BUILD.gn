import("//common-mk/pkg_config.gni")

pkg_config("target_defaults") {
  pkg_deps = [ "libchrome" ]
}

source_set("http_util") {
  public = [ "http_util.h" ]
  sources = [ "http_util.cc" ]
  configs += [ ":target_defaults" ]
  deps = [ ":smart_buffer" ]
}

source_set("smart_buffer") {
  public = [ "smart_buffer.h" ]
  sources = [ "smart_buffer.cc" ]
  configs += [ ":target_defaults" ]
}

source_set("value_util") {
  public = [ "value_util.h" ]
  sources = [ "value_util.cc" ]
  configs += [ ":target_defaults" ]
}

if (use.test) {
  pkg_config("test_config") {
    pkg_deps = [ "libchrome-test" ]
  }

  executable("smart-buffer-testrunner") {
    sources = [ "smart_buffer_test.cc" ]
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    deps = [
      ":smart_buffer",
      ":value_util",
      "//common-mk/testrunner",
    ]
    run_test = true
  }

  executable("http-util-testrunner") {
    sources = [ "http_util_test.cc" ]

    # TODO(oka); Remove //common-mk:test by making testrunner to public_config //common-mk:test
    configs += [
      "//common-mk:test",
      ":target_defaults",
      ":test_config",
    ]
    deps = [
      ":http_util",
      ":smart_buffer",
      ":value_util",
      "//common-mk/testrunner",
    ]
    run_test = true
  }
}
